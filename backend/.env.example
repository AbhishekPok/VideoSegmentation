# Copy to backend/.env and adjust. Every value here is optional for local runs.

# Database. Default (unset) = SQLite file at backend/data/planner.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://planner:change-me@localhost:5432/planner

# YouTube Data API v3 key (optional). Enables exact length + chapter auto-fill.
# Kept on the server only. Restrict it in Google Cloud Console to the
# "YouTube Data API v3" API, and on EC2 to the server's Elastic IP.
# YOUTUBE_API_KEY=

# Set to true once the site is served over HTTPS.
# COOKIE_SECURE=false
# SESSION_DAYS=30

# LOG_LEVEL=INFO
# LOG_JSON=true   # false = plain text logs, easier to read locally

# Serve ../frontend from FastAPI (local). In production nginx can serve it instead.
# SERVE_FRONTEND=true
